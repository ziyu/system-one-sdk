# Copy to .env.cloudflare for Cloudflare examples and opt-in live verification.
# The SDK defaults to typesafe/jev; select a Clef model explicitly for image input.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Optional overrides; live verification always uses the official endpoint.
# SYSTEM_ONE_BASE_URL=https://your-proxy.example/client/v4
# SYSTEM_ONE_MODEL=typesafe/jev
# SYSTEM_ONE_MODEL=@cf/cloudflare/clef
# Or @cf/cloudflare/clef-flash.
# Optional PNG/JPEG/WebP file for the example and Clef live verification (requires a Clef model):
# CLOUDFLARE_IMAGE_PATH=./receipt.png
