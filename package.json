{
  "name": "system-one-workspace",
  "description": "Independent System One packages, examples, and verification.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ziyu/system-one-sdk.git"
  },
  "homepage": "https://github.com/ziyu/system-one-sdk#readme",
  "bugs": {
    "url": "https://github.com/ziyu/system-one-sdk/issues"
  },
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:packages": "node scripts/build-packages.mjs",
    "build": "node scripts/build-packages.mjs",
    "typecheck": "npm run build:packages && tsc -p tsconfig.check.json",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run typecheck && npm run build && npm test && npm run test:scenarios",
    "test:scenarios": "npm run examples:build && node --test tests/examples/*.test.mjs",
    "test:package": "node scripts/test-package.mjs",
    "test:live": "npm run build && node scripts/test-live.mjs",
    "test:live:openrouter": "npm run build && node scripts/test-openrouter-live.mjs",
    "test:live:composition": "npm run build && node scripts/test-composition-live.mjs",
    "test:live:decisions": "npm run examples:build && node scripts/test-decisions-live.mjs",
    "test:live:cloudflare": "npm run build && node scripts/test-cloudflare-live.mjs",
    "examples:build": "npm run build:packages && tsc -p tsconfig.examples.json",
    "example": "npm run examples:build && node .examples/examples/basic.js",
    "example:agent": "npm run examples:build && node .examples/examples/realtime-agent.js",
    "example:openrouter": "npm run examples:build && node --env-file=.env.openrouter .examples/examples/openrouter.js",
    "example:cloudflare": "npm run examples:build && node --env-file=.env.cloudflare .examples/examples/cloudflare.js",
    "example:decisions": "npm run examples:build && node .examples/examples/decisions.js",
    "example:support": "npm run examples:build && node .examples/examples/support.js",
    "example:browser": "npm run examples:build && node .examples/examples/browser.js",
    "test:live:browser": "npm run examples:build && node .examples/examples/browser.js --task github-agents --task mdn-abort --headless",
    "test:browser": "npm run examples:build && node --test tests/browser/*.test.mjs",
    "demo:webgpu": "npm run build:packages && node scripts/serve-webgpu-demo.mjs",
    "test:live:laya": "npm run build:packages && node scripts/test-laya-webgpu.mjs",
    "test:live:laya:node": "npm run build:packages && node scripts/test-laya-node.mjs",
    "example:uncertainty": "npm run examples:build && node --env-file=.env .examples/examples/uncertainty.js",
    "example:batch": "npm run examples:build && node --env-file=.env .examples/examples/batch.js",
    "test:live:llm": "node scripts/build-packages.mjs adapter-llm && node scripts/build-packages.mjs transport-fetch && node scripts/test-llm-live.mjs",
    "test:workers": "npm run build && node scripts/test-cloudflare-workers-runtime.mjs",
    "changeset": "changeset",
    "version:packages": "node scripts/version.mjs",
    "release:prepare": "node scripts/release.mjs prepare",
    "release:publish": "node scripts/release.mjs publish",
    "test:release": "node scripts/test-release.mjs",
    "test:release:live": "node scripts/test-release-live.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "2.31.1",
    "@types/node": "22.20.3",
    "playwright": "1.63.0",
    "semver": "7.8.5",
    "typescript": "5.9.3"
  },
  "private": true
}
