{
  "name": "@system-one-ai/sdk",
  "version": "0.5.0",
  "description": "Dependency-free, typed System One decisions for Jev and compatible models, with optional protocol adapters.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ziyu/sytem-one-sdk.git"
  },
  "homepage": "https://github.com/ziyu/sytem-one-sdk#readme",
  "bugs": {
    "url": "https://github.com/ziyu/sytem-one-sdk/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": { "types": "./dist/esm/index.d.ts", "default": "./dist/esm/index.js" },
      "require": { "types": "./dist/cjs/index.d.ts", "default": "./dist/cjs/index.js" }
    },
    "./adapters/vercel": {
      "import": { "types": "./dist/esm/adapters/vercel.d.ts", "default": "./dist/esm/adapters/vercel.js" },
      "require": { "types": "./dist/cjs/adapters/vercel.d.ts", "default": "./dist/cjs/adapters/vercel.js" }
    },
    "./adapters/openrouter": {
      "import": { "types": "./dist/esm/adapters/openrouter.d.ts", "default": "./dist/esm/adapters/openrouter.js" },
      "require": { "types": "./dist/cjs/adapters/openrouter.d.ts", "default": "./dist/cjs/adapters/openrouter.js" }
    },
    "./adapters/cloudflare": {
      "import": { "types": "./dist/esm/adapters/cloudflare.d.ts", "default": "./dist/esm/adapters/cloudflare.js" },
      "require": { "types": "./dist/cjs/adapters/cloudflare.d.ts", "default": "./dist/cjs/adapters/cloudflare.js" }
    },
    "./decisions": {
      "import": { "types": "./dist/esm/decisions.d.ts", "default": "./dist/esm/decisions.js" },
      "require": { "types": "./dist/cjs/decisions.d.ts", "default": "./dist/cjs/decisions.js" }
    },
    "./policies": {
      "import": { "types": "./dist/esm/policies.d.ts", "default": "./dist/esm/policies.js" },
      "require": { "types": "./dist/cjs/policies.d.ts", "default": "./dist/cjs/policies.js" }
    },
    "./batch": {
      "import": { "types": "./dist/esm/batch.d.ts", "default": "./dist/esm/batch.js" },
      "require": { "types": "./dist/cjs/batch.d.ts", "default": "./dist/cjs/batch.js" }
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "README.zh-CN.md", "LICENSE", "docs"],
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run typecheck && npm run build && npm test",
    "test:package": "node scripts/test-package.mjs",
    "test:live": "npm run build && node --env-file=.env scripts/test-live.mjs",
    "test:live:openrouter": "npm run build && node scripts/test-openrouter-live.mjs",
    "test:live:composition": "npm run build && node scripts/test-composition-live.mjs",
    "test:live:cloudflare": "npm run build && node scripts/test-cloudflare-live.mjs",
    "examples:build": "tsc -p tsconfig.examples.json",
    "example": "npm run examples:build && node .examples/examples/basic.js",
    "example:agent": "npm run examples:build && node .examples/examples/realtime-agent.js",
    "example:openrouter": "npm run examples:build && node --env-file=.env.openrouter .examples/examples/openrouter.js",
    "example:cloudflare": "npm run examples:build && node --env-file=.env.cloudflare .examples/examples/cloudflare.js",
    "example:decisions": "npm run examples:build && node --env-file=.env .examples/examples/decisions.js",
    "example:uncertainty": "npm run examples:build && node --env-file=.env .examples/examples/uncertainty.js",
    "example:batch": "npm run examples:build && node --env-file=.env .examples/examples/batch.js",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "22.20.3",
    "typescript": "5.9.3"
  }
}
