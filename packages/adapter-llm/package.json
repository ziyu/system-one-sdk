{
  "name": "@system-one-ai/adapter-llm",
  "version": "0.7.0",
  "description": "LLM-backed decision adapter.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@system-one-ai/core": "^0.6.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ziyu/system-one-sdk.git",
    "directory": "packages/adapter-llm"
  },
  "scripts": {
    "build": "node ../../scripts/build-packages.mjs adapter-llm",
    "typecheck": "node ../../scripts/build-packages.mjs adapter-llm --check",
    "test": "node ../../scripts/test-workspace.mjs adapter-llm",
    "prepack": "npm run build"
  }
}
