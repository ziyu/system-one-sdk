{
  "name": "@system-one-ai/model-laya",
  "version": "0.2.0",
  "description": "Optional Laya model plugins for System One browser and Node runtimes.",
  "license": "(MIT AND Apache-2.0)",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./browser": {
      "import": {
        "types": "./dist/esm/browser.d.ts",
        "default": "./dist/esm/browser.js"
      },
      "require": {
        "types": "./dist/cjs/browser.d.ts",
        "default": "./dist/cjs/browser.js"
      }
    },
    "./node": {
      "import": {
        "types": "./dist/esm/node.d.ts",
        "default": "./dist/esm/node.js"
      },
      "require": {
        "types": "./dist/cjs/node.d.ts",
        "default": "./dist/cjs/node.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@system-one-ai/adapter-webgpu": "^0.2.0",
    "@system-one-ai/runtime-onnx-node": "^0.2.0",
    "@system-one-ai/core": "^0.6.0"
  },
  "peerDependencies": {
    "@huggingface/transformers": "^3.8.1"
  },
  "peerDependenciesMeta": {
    "@huggingface/transformers": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ziyu/system-one-sdk.git",
    "directory": "packages/model-laya"
  },
  "scripts": {
    "build": "node ../../scripts/build-packages.mjs model-laya",
    "typecheck": "node ../../scripts/build-packages.mjs model-laya --check",
    "test": "node ../../scripts/test-workspace.mjs model-laya",
    "prepack": "npm run build"
  }
}
