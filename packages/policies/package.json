{
  "name": "@system-one-ai/policies",
  "version": "0.5.2",
  "description": "System One policies.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@system-one-ai/core": "^0.5.2"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ziyu/sytem-one-sdk.git",
    "directory": "packages/policies"
  },
  "scripts": {
    "build": "node ../../scripts/build-packages.mjs policies",
    "typecheck": "node ../../scripts/build-packages.mjs policies --check",
    "test": "node ../../scripts/test-workspace.mjs policies",
    "prepack": "npm run build"
  }
}
